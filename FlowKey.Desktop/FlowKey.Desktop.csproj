<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../assets/flowkey.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <PublishSingleFile Condition="'$(Configuration)' == 'Release'">true</PublishSingleFile>
    <IncludeAllContentForSelfExtract Condition="'$(Configuration)' == 'Release'">true</IncludeAllContentForSelfExtract>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FlowKey.Core/FlowKey.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3595.46" />
    <EmbeddedResource Include="../index.html" LogicalName="FlowKey.Assets.index.html" />
    <EmbeddedResource Include="../app.js" LogicalName="FlowKey.Assets.app.js" />
    <EmbeddedResource Include="../desktop.js" LogicalName="FlowKey.Assets.desktop.js" />
    <EmbeddedResource Include="../desktop-ui.css" LogicalName="FlowKey.Assets.desktop-ui.css" />
    <EmbeddedResource Include="../branding.css" LogicalName="FlowKey.Assets.branding.css" />
    <EmbeddedResource Include="../assets/flowkey.svg" LogicalName="FlowKey.Assets.assets/flowkey.svg" />
    <EmbeddedResource Include="../assets/NotoSerifTC.ttf" LogicalName="FlowKey.Assets.assets/NotoSerifTC.ttf" />
    <EmbeddedResource Include="../assets/OFL-NotoSerifTC.txt" LogicalName="FlowKey.Assets.assets/OFL-NotoSerifTC.txt" />
    <Resource Include="../assets/flowkey.ico" Link="Assets/flowkey.ico" />
  </ItemGroup>
</Project>
