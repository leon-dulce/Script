<Window x:Class="FlowKey.Desktop.FlowDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="FlowKey" Width="460" SizeToContent="Height" MaxHeight="540"
 ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="#222730" Foreground="#E5E9F0" FontFamily="Microsoft JhengHei UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#303846"/><Setter Property="Foreground" Value="#E5E9F0"/>
   <Setter Property="BorderBrush" Value="#535F72"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="20,10"/><Setter Property="MinWidth" Value="100"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B5C5FF"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" TextWrapping="Wrap"/>
  <ScrollViewer Grid.Row="1" MaxHeight="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <TextBlock x:Name="Message" Foreground="#B8C1D0" TextWrapping="Wrap" LineHeight="24"/>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
   <Button x:Name="CancelAction" Content="取消" IsCancel="True" Margin="0,0,10,0" Click="CancelClick"/>
   <Button x:Name="AcceptAction" Content="知道了" Background="#465FFF" Foreground="White" BorderBrush="#465FFF" Click="AcceptClick"/>
  </StackPanel>
 </Grid>
</Window>
